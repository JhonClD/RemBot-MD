# Copia este archivo como .env y ajusta los valores.
# .env está excluido por .gitignore: nunca lo publiques.

# El prefijo de los comandos es fijo: comilla invertida (`).

# Números autorizados (owners), separados por comas y solo con dígitos.
BOT_OWNER_NUMBER=

# Identificadores LID de los owners (opcional, separados por comas).
BOT_OWNER_LID=

# Ruta al binario de FFmpeg si no se llama ffmpeg o no está en PATH.
# FFMPEG_PATH=/data/data/com.termux/files/usr/bin/ffmpeg
